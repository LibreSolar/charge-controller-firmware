menuconfig HALF_BRIDGE
    bool "Half-bridge drivers"
    default y if DT_HAS_LIBRESOLAR_STM32_ADVTIM_HALF_BRIDGE_ENABLED
    default y if DT_HAS_LIBRESOLAR_STM32_GPTIM_HALF_BRIDGE_ENABLED
    default y if DT_HAS_LIBRESOLAR_STM32_HRTIM_HALF_BRIDGE_ENABLED
    default y if DT_HAS_LIBRESOLAR_HALF_BRIDGE_EMUL_ENABLED
    help
      Enable drivers for half bridges consisting of two complementary PWM outputs with dead time,
      e.g. used in DC/DC converters.

if HALF_BRIDGE

config HALF_BRIDGE_INIT_PRIORITY
    int "Half-bridge init priority"
    default KERNEL_INIT_PRIORITY_DEVICE
    help
      Half-bridge driver device initialization priority.

module = HALF_BRIDGE
module-str = half_bridge
source "subsys/logging/Kconfig.template.log_config"

config HALF_BRIDGE_STM32_TIM
    bool
    select USE_STM32_LL_TIM
    select PINCTRL
    select RESET
    help
      Common functions for half-bridge drivers using STM32 timers (TIM).

config HALF_BRIDGE_STM32_ADVTIM
    bool "STM32 advanced-control timer half-bridge driver"
    default y
    depends on DT_HAS_LIBRESOLAR_STM32_ADVTIM_HALF_BRIDGE_ENABLED
    select HALF_BRIDGE_STM32_TIM
    help
      Enable half-bridge driver for STM32 advanced-control timers (e.g. TIM1) using
      complementary outputs with hardware dead time generation.

config HALF_BRIDGE_STM32_GPTIM
    bool "STM32 general-purpose timer half-bridge driver"
    default y
    depends on DT_HAS_LIBRESOLAR_STM32_GPTIM_HALF_BRIDGE_ENABLED
    select HALF_BRIDGE_STM32_TIM
    help
      Enable half-bridge driver for STM32 general-purpose timers (e.g. TIM3) using two
      independent channels with dead time generated by software.

config HALF_BRIDGE_STM32_HRTIM
    bool "STM32 HRTIM half-bridge driver"
    default y
    depends on DT_HAS_LIBRESOLAR_STM32_HRTIM_HALF_BRIDGE_ENABLED
    select PINCTRL
    select RESET
    help
      Enable half-bridge driver for the STM32 high-resolution timer (HRTIM).

config HALF_BRIDGE_EMUL
    bool "Emulated half-bridge driver"
    default y
    depends on DT_HAS_LIBRESOLAR_HALF_BRIDGE_EMUL_ENABLED
    help
      Enable emulated half-bridge driver for tests on native_sim.

endif # HALF_BRIDGE
